---
import type { CollectionEntry } from "astro:content";

interface Props {
	project: CollectionEntry<"project">;
}

const { project } = Astro.props;
const { title, description, platforms, genre, coverImage, draft, highlight, wip } = project.data;
const href = `/projects/${project.id}/`;
---

<article
	class:list={[
		"bg-global-bg/65 flex h-full flex-col overflow-hidden rounded border shadow-lg transition-colors duration-200",
		highlight
			? "border-[#C85951]/70 hover:border-[#C85951]"
			: wip
				? "border-[#9898AC]/70 hover:border-[#9898AC]"
				: "border-quote/20 hover:border-accent/60",
	]}
>
	{highlight && <div class="h-1 w-full shrink-0 bg-[#C85951]" />}
	{!highlight && wip && <div class="h-1 w-full shrink-0 bg-[#9898AC]" />}
	<a href={href} class="relative block">
		{
			coverImage ? (
				<div class="aspect-[8/3] overflow-hidden">
					<img
						alt={coverImage.alt}
						src={coverImage.src}
						class="h-full w-full object-cover transition-opacity hover:opacity-90"
					/>
				</div>
			) : (
				<div class="bg-quote/5 flex aspect-[8/3] items-center justify-center">
					<span class="text-muted text-sm">No image</span>
				</div>
			)
		}
		{
			highlight && (
				<span class="text-global-bg absolute top-2 right-2 rounded bg-[#C85951] px-2 py-1 text-xs font-bold tracking-wide uppercase">
					Featured
				</span>
			)
		}
		{
			!highlight && wip && (
				<span class="text-global-bg absolute top-2 right-2 rounded bg-[#9898AC] px-2 py-1 text-xs font-bold tracking-wide uppercase">
					WIP
				</span>
			)
		}
	</a>
	<div class="flex flex-1 flex-col gap-2 p-4">
		{draft && <span class="text-sm text-red-500">(Draft)</span>}
		<h3 class="text-lg font-semibold">
			<a class="cactus-link" href={href}>{title}</a>
		</h3>
		{
			(platforms.length > 0 || genre.length > 0) && (
				<div class="flex flex-wrap gap-1.5">
					{platforms.map((p: string) => (
						<span class="rounded border border-zinc-500/50 bg-zinc-600 px-2 py-0.5 text-xs text-zinc-100">
							{p}
						</span>
					))}
					{genre.map((g: string) => (
						<span class="bg-quote/10 border-quote/25 rounded border px-2 py-0.5 text-xs">{g}</span>
					))}
				</div>
			)
		}
		<p class="text-muted line-clamp-2 text-sm">{description}</p>
	</div>
</article>
