---
import ProjectCard from "@/components/project/ProjectCard.astro";
import { getAllProjects, groupProjectsByCategory } from "@/data/project";
import PageLayout from "@/layouts/Base.astro";

const allProjects = await getAllProjects();
const grouped = groupProjectsByCategory(allProjects);

const categories: { key: string; label: string }[] = [
	{ key: "commercial", label: "Commercial Releases" },
	{ key: "unreleased", label: "Unreleased Commercial Projects" },
	{ key: "additional", label: "Additional Projects" },
];

const meta = {
	description: "Game design portfolio projects by Harvey Brown",
	title: "Projects",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">Projects</h1>
	{
		categories.map(({ key, label }) => {
			const projects = grouped[key];
			if (!projects?.length) return null;
			return (
				<section class="mb-16">
					<h2 class="title mb-8 text-xl">{label}</h2>
					<ul class="grid gap-10 sm:grid-cols-2" role="list">
						{projects.map((project) => (
							<li>
								<ProjectCard project={project} />
							</li>
						))}
					</ul>
				</section>
			);
		})
	}
</PageLayout>
