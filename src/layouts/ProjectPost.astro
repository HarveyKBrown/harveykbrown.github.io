---
import { type CollectionEntry } from "astro:content";
import BaseLayout from "./Base.astro";

interface Props {
	project: CollectionEntry<"project">;
}

const { project } = Astro.props;
const { title, description, role, platforms, genre, coverImage, video, externalUrl, category, draft } =
	project.data;

const categoryLabels: Record<string, string> = {
	commercial: "Commercial Releases",
	unreleased: "Unreleased Commercial Projects",
	additional: "Additional Projects",
};
const categoryLabel = categoryLabels[category] ?? category;
---

<BaseLayout meta={{ title, description }}>
	<article class="grow break-words" data-pagefind-body>
		<div id="project-hero" class="mb-12">
			{
				video && (
					<div class="mb-6 aspect-video overflow-hidden rounded">
						<video
							src={video}
							class="h-full w-full object-cover"
							controls
							preload="metadata"
						/>
					</div>
				)
			}
			{
				!video && coverImage && (
					<div class="mb-6 aspect-video overflow-hidden rounded">
						<img
							alt={coverImage.alt}
							src={coverImage.src}
							class="h-full w-full object-cover"
							style={coverImage.position ? `object-position: ${coverImage.position}` : undefined}
						/>
					</div>
				)
			}
			<nav class="text-muted mb-2 text-sm" aria-label="Breadcrumb">
				<a class="cactus-link text-accent" href="/projects/">Projects</a>
				<span aria-hidden="true"> / </span>
				<span>{categoryLabel}</span>
			</nav>
			{draft && <span class="text-sm text-red-500">(Draft)</span>}
			<h1 class="title">{title}</h1>
			<p class="text-muted mt-1">{role}</p>
			{
				(platforms.length > 0 || genre.length > 0) && (
					<div class="mt-3 flex flex-wrap gap-2">
						{platforms.map((p) => (
							<span class="rounded border border-zinc-500/50 bg-zinc-600 px-2 py-0.5 text-sm text-zinc-100">{p}</span>
						))}
						{genre.map((g) => (
							<span class="bg-quote/10 border-quote/25 rounded border px-2 py-0.5 text-sm">{g}</span>
						))}
					</div>
				)
			}
			{
				externalUrl && (
					<a
						class="border-accent text-accent hover:bg-accent hover:text-global-bg mt-6 inline-block rounded border-2 px-6 py-3 font-semibold transition-colors duration-200"
						href={externalUrl}
						rel="noreferrer noopener"
						target="_blank"
					>
						View Project <span aria-hidden="true">→</span>
					</a>
				)
			}
		</div>
		<div
			class="prose prose-sm max-w-none prose-headings:font-semibold prose-headings:text-accent-2 prose-headings:before:absolute prose-headings:before:-ms-4 prose-headings:before:text-muted prose-headings:hover:before:text-accent sm:prose-headings:before:content-['#'] sm:prose-th:before:content-none"
		>
			<slot />
		</div>
	</article>
	<button
		class="hover:border-link fixed end-4 bottom-8 z-90 flex h-10 w-10 translate-y-28 cursor-pointer items-center justify-center rounded-full border-2 border-transparent bg-zinc-200 text-3xl opacity-0 transition-all transition-discrete duration-300 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8 sm:h-12 sm:w-12 dark:bg-zinc-700"
		data-show="false"
		id="to-top-btn"
	>
		<span class="sr-only">Back to top</span>
		<svg
			aria-hidden="true"
			class="h-6 w-6"
			fill="none"
			focusable="false"
			stroke="currentColor"
			stroke-width="2"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>
</BaseLayout>

<script>
	const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
	const targetHeader = document.getElementById("project-hero") as HTMLDivElement;

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			scrollBtn.dataset.show = (!entry.isIntersecting).toString();
		});
	}

	scrollBtn.addEventListener("click", () => {
		document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
	});

	const observer = new IntersectionObserver(callback);
	observer.observe(targetHeader);
</script>
